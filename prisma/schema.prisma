// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// --- Enum 정의 ---

// 반려동물 종류
enum AnimalType {
  dog
  cat
}

// 반려동물 생애주기
enum LifeStage {
  puppy
  adult
  senior
}

enum UserRole {
  USER
  ADMIN
}

enum RequestStatus {
  PENDING
  PROCESSING
  COMPLETED
}

// 사료 정보
model Food {
  id              Int      @id @default(autoincrement())
  name            String
  brand           String
  animalType      AnimalType
  lifeStage       LifeStage
  sizeCategory    String
  isPrescription  Boolean
  country         String?
  sourceUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  //relations
  analysis        GuaranteedAnalysis?
  ingredients     Ingredient[]
  proteins        ProteinSource[]
  carbohydrates   CarbohydrateSource[]
  vegetables      VegetableSource[]
  logs FoodViewLog[]

  @@index([brand])
  @@index([animalType, lifeStage, sizeCategory])
}

// 영양성분 정보
model GuaranteedAnalysis {
  id         Int   @id @default(autoincrement())
  foodId     Int   @unique
  food       Food  @relation(fields: [foodId], references: [id], onDelete: Cascade)

  protein    Float?
  fat        Float?
  fiber      Float?
  ash        Float?
  moisture   Float?

  calcium    Float?
  phosphorus Float?
  sodium     Float?

  omega3     Float?
  omega6     Float?
}

// 사료 원재료 정보
model Ingredient {
  id             Int    @id @default(autoincrement())
  foodId         Int
  food           Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  ingredientRaw  String

  @@index([foodId])
}

// 사료 단백질 원료 정보
model ProteinSource {
  id           Int     @id @default(autoincrement())
  foodId       Int
  food         Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)

  proteinType  String
  sourceRaw    String?
  isPrimary    Boolean

  @@index([foodId])
  @@index([proteinType])
}

// 사료 탄수화물 원료 정보
model CarbohydrateSource {
  id        Int     @id @default(autoincrement())
  foodId    Int
  food      Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)

  carbType  String
  sourceRaw String?

  @@index([foodId])
}

model FoodViewLog {
  id        Int      @id @default(autoincrement())
  foodId    Int
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  type      String   @default("VIEW")
  createdAt DateTime @default(now()) // 조회된 시간

  @@index([foodId])
  @@index([createdAt]) // 기간 검색 성능 최적화를 위한 인덱스
}

// 사료 야채 원료 정보
model VegetableSource {
  id            Int     @id @default(autoincrement())
  foodId        Int
  food          Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)

  vegetableType String
  sourceRaw     String?

  @@index([foodId])
}

// 유저 및 인증 관련 모델

model User {
  id            String    @id @default(cuid())
  name          String?
  nickname      String?   @unique // 가입 시 입력받을 닉네임
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // 암호화된 비밀번호 저장 (bcrypt 사용 예정)
  role          UserRole  @default(USER) // 기본값은 일반 유저
  
  accounts      Account[]
  sessions      Session[]
  requests      Request[] // 유저가 작성한 요청사항들

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- 요청 사항 게시판 모델 ---

model Request {
  id        Int           @id @default(autoincrement())
  title     String
  content   String        @db.Text
  status    RequestStatus @default(PENDING) // 관리자가 업데이트할 상태
  adminNote String?       @db.Text        // 관리자의 답변이나 메모
  
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
}
